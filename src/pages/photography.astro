---
import BaseLayout from "../layouts/BaseLayout.astro";
import { photography as photos } from "../data/content/collections.js";
---
 
<BaseLayout title="Photography — Jinghao Wen">
<section class="page active" id="photography">
  <div class="sec-eye en">Visual Notes</div><div class="sec-eye zh" style="display:none">视觉笔记</div>
  <h1 class="sec-h1 en">Photography</h1><h1 class="sec-h1 zh" style="display:none">摄影</h1>
  <div class="sec-rule"></div>
  <div class="photography-intro">
    <img class="photography-intro-image" src="/images/photography-intro.jpg" alt="Cameras and film arranged in front of a home bar" />
    <p class="photography-intro-copy en">A blogger I once loved following, Tim, once said, “My advice is to make more use of that thing on the back of your phone. Compared with knowing everything under the sun, perhaps it matters more to hold on to the people right in front of you. Some say you do not have to understand photography, but you must understand life. It does not matter if your photographs are not good; what is most regrettable is failing to record the moment at all. Once many things have passed, they can no longer be reconstructed out of thin air. The instant you press the shutter, time stops there. Its meaning lies in turning a moment lived to the fullest into something eternal……” I could not agree more. Time punishes everyone who fails to record it. There is no longer even a single image or video that can take me back to beneath Zhongxuan Tower in 2015, a Hyde Park afternoon in 2017, the lunch-break wake-up bell playing <em>The Wind Rises</em> at No. 5 High School in the summer of 2018, nights spent working around the clock in the lab during the summer of 2022, or my starry-eyed, backpacker-like journey across half of China in 2024…… I do not want to look back on this chapter years from now and find only blurred memories. So in the days ahead, I will live well—and record it well.</p>
    <p class="photography-intro-copy zh" style="display:none">曾经我很喜欢的一位博主Tim说过“我的建议是，多用手机背面的这个东西，相比知道天下事，留住眼前人或许更重要一点。有人说你可以不懂摄影，但一定要懂生活，你拍的不好没有关系，没有记录下来才是最可惜的。因为很多东西过后，已经不能凭空想象起来，当按下快门的那一刻，时间就停在了这里。它的意义在于，把尽兴的瞬间，变成一个永恒的......”。我深以为意。时间会惩罚每一个没有记录的人，正如再也没有哪怕一段图像或者影像，可以把我带回2015年的仲宣楼下，2017年海德公园的午后，2018年夏天五中午休起床铃响起的《起风了》，2022年暑假实验室通宵达旦，2024年中二的像个背包客一样走过了半个中国......我不想在多年以后，回想起现在这段时光时只剩下模糊的记忆，所以我将在接下来的日子里，好好生活，好好记录。</p>
  </div>

  <section class="camera-gear" aria-labelledby="camera-gear-title">
    <div class="camera-gear-heading">
      <div>
        <div class="camera-gear-eye en">Tools of the craft</div>
        <div class="camera-gear-eye zh" style="display:none">拍摄工具</div>
        <h2 class="camera-gear-title en" id="camera-gear-title">My cameras</h2>
        <h2 class="camera-gear-title zh" style="display:none">我的摄影设备</h2>
      </div>
      <span class="camera-gear-count">04</span>
    </div>

    <div class="camera-gear-grid">
      <article class="camera-gear-card">
        <div class="camera-gear-image">
          <img src="/images/cameras/fujifilm-x-s20.png" alt="Fujifilm X-S20 mirrorless camera" />
        </div>
        <div class="camera-gear-body">
          <span class="camera-gear-type en">Digital · Mirrorless</span>
          <span class="camera-gear-type zh" style="display:none">数码 · 无反</span>
          <h3>Fujifilm X-S20</h3>
          <p class="en">Acquired January 2025 · $1650</p>
          <p class="zh" style="display:none">2025年1月购入 · $1650</p>
        </div>
      </article>

      <article class="camera-gear-card">
        <div class="camera-gear-image">
          <img src="/images/cameras/canon-ae1.png" alt="Canon AE-1 35mm film camera" />
        </div>
        <div class="camera-gear-body">
          <span class="camera-gear-type en">35mm · Film SLR</span>
          <span class="camera-gear-type zh" style="display:none">35mm · 胶片单反</span>
          <h3>Canon AE-1</h3>
          <p class="en">Acquired May 2026 · $525</p>
          <p class="zh" style="display:none">2026年5月购入 · $525</p>
        </div>
      </article>

      <article class="camera-gear-card">
        <div class="camera-gear-image">
          <img src="/images/cameras/pentax-17.jpg" alt="Pentax 17 half-frame film camera" />
        </div>
        <div class="camera-gear-body">
          <span class="camera-gear-type en">35mm · Half-frame</span>
          <span class="camera-gear-type zh" style="display:none">35mm · 半格胶片</span>
          <h3>Pentax 17</h3>
          <p class="en">Acquired August 2026 · $550</p>
          <p class="zh" style="display:none">2026年8月购入 · $550</p>
        </div>
      </article>

      <article class="camera-gear-card">
        <div class="camera-gear-image">
          <img src="/images/cameras/instax-mini-99.jpg" alt="Fujifilm Instax mini 99 instant camera" />
        </div>
        <div class="camera-gear-body">
          <span class="camera-gear-type en">Instant · Instax mini</span>
          <span class="camera-gear-type zh" style="display:none">即时成像 · Instax mini</span>
          <h3>Fujifilm Instax mini 99</h3>
          <p class="en">Acquired January 2026 · $225</p>
          <p class="zh" style="display:none">2026年1月购入 · $225</p>
        </div>
      </article>
    </div>
    <p class="camera-gear-credit en">Product images © their respective manufacturers and retailers.</p>
    <p class="camera-gear-credit zh" style="display:none">产品图片版权归相应制造商及零售商所有。</p>
  </section>
 
  <div class="photo-filters" aria-label="Photography filters">
    <div class="photo-filter-row">
      <span class="photo-filter-label en">Medium</span><span class="photo-filter-label zh" style="display:none">媒介</span>
      <div class="photo-topics" role="group" aria-label="Medium">
        <button class="photo-topic-btn on" data-filter-group="medium" data-filter-value="all" onclick="setPhotographyFilter(this)"><span class="en">All</span><span class="zh" style="display:none">全部</span></button>
        <button class="photo-topic-btn" data-filter-group="medium" data-filter-value="digital" onclick="setPhotographyFilter(this)"><span class="en">Digital</span><span class="zh" style="display:none">数码</span></button>
        <button class="photo-topic-btn" data-filter-group="medium" data-filter-value="film" onclick="setPhotographyFilter(this)"><span class="en">Film</span><span class="zh" style="display:none">胶卷</span></button>
      </div>
    </div>

    <div class="photo-filter-row">
      <span class="photo-filter-label en">Subject</span><span class="photo-filter-label zh" style="display:none">题材</span>
      <div class="photo-topics" role="group" aria-label="Subject">
        <button class="photo-topic-btn on" data-filter-group="topic" data-filter-value="all" onclick="setPhotographyFilter(this)"><span class="en">All</span><span class="zh" style="display:none">全部</span></button>
        <button class="photo-topic-btn" data-filter-group="topic" data-filter-value="street" onclick="setPhotographyFilter(this)"><span class="en">Street</span><span class="zh" style="display:none">街拍</span></button>
        <button class="photo-topic-btn" data-filter-group="topic" data-filter-value="nature" onclick="setPhotographyFilter(this)"><span class="en">Nature</span><span class="zh" style="display:none">自然</span></button>
        <button class="photo-topic-btn" data-filter-group="topic" data-filter-value="food" onclick="setPhotographyFilter(this)"><span class="en">Food</span><span class="zh" style="display:none">美食</span></button>
        <button class="photo-topic-btn" data-filter-group="topic" data-filter-value="travel" onclick="setPhotographyFilter(this)"><span class="en">Travel</span><span class="zh" style="display:none">旅行</span></button>
        <button class="photo-topic-btn" data-filter-group="topic" data-filter-value="museum" onclick="setPhotographyFilter(this)"><span class="en">Museum</span><span class="zh" style="display:none">博物馆</span></button>
        <button class="photo-topic-btn" data-filter-group="topic" data-filter-value="portrait" onclick="setPhotographyFilter(this)"><span class="en">Portrait</span><span class="zh" style="display:none">人像</span></button>
      </div>
    </div>

    <div class="photo-filter-row" id="film-stock-filter" hidden>
      <span class="photo-filter-label en">Film stock</span><span class="photo-filter-label zh" style="display:none">胶卷型号</span>
      <div class="photo-topics" id="film-stock-options" role="group" aria-label="Film stock"></div>
    </div>
  </div>

  <!-- Every photo needs data-medium="digital" or "film". Film photos also need data-film and the stock name in both captions. -->
  <div class="photo-grid" id="photo-grid">
    {photos.filter((photo) => photo.published).map((photo) => (
      <div class="photo-cell" data-medium={photo.medium} data-film={photo.medium === 'film' ? photo.filmStock : undefined} data-topic={photo.topic} onclick="openLightbox(this)">
        <img src={photo.image} alt={photo.alt} loading="lazy" decoding="async" />
        <p class="photo-caption en">{photo.captionEn}</p>
        <p class="photo-caption zh" style="display:none">{photo.captionZh}</p>
      </div>
    ))}
  </div>
  <p class="photo-empty" id="photo-empty" hidden>
    <span class="en">No photographs match these filters yet.</span>
    <span class="zh" style="display:none">暂时没有符合这些筛选条件的照片。</span>
  </p>
</section>

<!-- ── LIGHTBOX ── -->
<div id="lightbox" onclick="closeLightbox()">
  <button id="lightbox-close" onclick="closeLightbox()">✕</button>
  <button id="lightbox-prev" onclick="lightboxNav(event,-1)">‹</button>
  <button id="lightbox-next" onclick="lightboxNav(event,1)">›</button>
  <div id="lightbox-inner">
    <img id="lightbox-img" src="" alt="">
    <p id="lightbox-caption"></p>
  </div>
</div>
 
<style>
/* ── Lightbox overlay ── */
#lightbox{
  display:none;
  position:fixed;
  inset:0;
  z-index:600;
  background:rgba(0,0,0,.92);
  align-items:center;
  justify-content:center;
  cursor:zoom-out;
}
#lightbox.open{display:flex;}
 
#lightbox-inner{
  position:relative;
  max-width:90vw;
  max-height:90vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:.8rem;
  cursor:default;
}
#lightbox-img{
  max-width:90vw;
  max-height:82vh;
  object-fit:contain;
  border-radius:4px;
  box-shadow:0 8px 48px rgba(0,0,0,.6);
  display:block;
}
#lightbox-caption{
  color:rgba(255,255,255,.6);
  font-size:.78rem;
  letter-spacing:.04em;
  text-align:center;
}
 
/* Close button */
#lightbox-close{
  position:fixed;
  top:1.2rem;
  right:1.4rem;
  background:rgba(255,255,255,.12);
  border:none;
  color:#fff;
  font-size:1.2rem;
  width:36px;
  height:36px;
  border-radius:50%;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:background .2s;
  z-index:601;
}
#lightbox-close:hover{background:rgba(255,255,255,.25);}
 
/* Prev / Next buttons */
#lightbox-prev,
#lightbox-next{
  position:fixed;
  top:50%;
  transform:translateY(-50%);
  background:rgba(255,255,255,.1);
  border:none;
  color:#fff;
  font-size:2rem;
  width:44px;
  height:64px;
  border-radius:4px;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:background .2s;
  z-index:601;
}
#lightbox-prev{left:1rem;}
#lightbox-next{right:1rem;}
#lightbox-prev:hover,
#lightbox-next:hover{background:rgba(255,255,255,.22);}
 
/* Hover effect on photo cells */
.photo-cell{
  cursor:pointer;
  transition:transform .2s, box-shadow .2s;
}
.photo-cell:hover{
  transform:translateY(-3px);
  box-shadow:0 8px 28px rgba(0,0,0,.12);
}
.photo-cell img{
  transition:opacity .2s;
}
.photo-cell:hover img{
  opacity:.92;
}
 
@media(max-width:768px){
  #lightbox-prev{left:.3rem;}
  #lightbox-next{right:.3rem;}
  #lightbox-img{max-width:96vw;max-height:78vh;}
}
</style>
 
<script is:inline>
(function(){
  // Collect all visible photo cells with real images
  var _cells = [];
  var _current = 0;
 
  function getCaption(cell){
    var isZh = document.documentElement.lang === 'zh-CN';
    var caps = cell.querySelectorAll('.photo-caption');
    for(var i=0;i<caps.length;i++){
      var el = caps[i];
      if(isZh && el.classList.contains('zh')) return el.textContent;
      if(!isZh && el.classList.contains('en')) return el.textContent;
    }
    return '';
  }
 
  function showLightbox(index){
    var cell = _cells[index];
    if(!cell) return;
    var img = cell.querySelector('img');
    var lb = document.getElementById('lightbox');
    var lbImg = document.getElementById('lightbox-img');
    var lbCap = document.getElementById('lightbox-caption');
 
    if(img){
      lbImg.src = img.src;
      lbImg.alt = img.alt || '';
      lbImg.style.display = 'block';
    } else {
      lbImg.src = '';
      lbImg.style.display = 'none';
    }
    lbCap.textContent = getCaption(cell);
    _current = index;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
 
  window.openLightbox = function(cell){
    // Only open if cell has a real image
    if(!cell.querySelector('img')) return;
    // Build list of currently visible cells that have images
    _cells = Array.from(document.querySelectorAll('.photo-cell'))
      .filter(function(c){ return !c.hidden && c.querySelector('img'); });
    var idx = _cells.indexOf(cell);
    if(idx === -1) idx = 0;
    showLightbox(idx);
  };
 
  window.closeLightbox = function(){
    document.getElementById('lightbox').classList.remove('open');
    document.body.style.overflow = '';
  };
 
  window.lightboxNav = function(e, dir){
    e.stopPropagation();
    var next = (_current + dir + _cells.length) % _cells.length;
    showLightbox(next);
  };
 
  // Keyboard navigation
  document.addEventListener('keydown', function(e){
    var lb = document.getElementById('lightbox');
    if(!lb.classList.contains('open')) return;
    if(e.key === 'Escape') closeLightbox();
    if(e.key === 'ArrowRight') lightboxNav(e, 1);
    if(e.key === 'ArrowLeft')  lightboxNav(e, -1);
  });

  // ── Composable medium / subject / film-stock filters ──
  var photoFilters = { medium: 'all', topic: 'all', film: 'all' };

  function applyPhotographyFilters(){
    var visibleCount = 0;
    document.querySelectorAll('#photo-grid .photo-cell').forEach(function(cell){
      // Existing photos are digital unless explicitly marked as film.
      var medium = cell.dataset.medium || 'digital';
      var film = cell.dataset.film || '';
      var matchesMedium = photoFilters.medium === 'all' || medium === photoFilters.medium;
      var matchesTopic = photoFilters.topic === 'all' || cell.dataset.topic === photoFilters.topic;
      var matchesFilm = photoFilters.medium !== 'film' || photoFilters.film === 'all' || film === photoFilters.film;
      var isVisible = matchesMedium && matchesTopic && matchesFilm;
      cell.hidden = !isVisible;
      if(isVisible) visibleCount++;
    });

    document.getElementById('photo-empty').hidden = visibleCount !== 0;
    document.getElementById('film-stock-filter').hidden = photoFilters.medium !== 'film';
  }

  window.setPhotographyFilter = function(btn){
    var group = btn.dataset.filterGroup;
    var value = btn.dataset.filterValue;
    photoFilters[group] = value;

    document.querySelectorAll('[data-filter-group="' + group + '"]').forEach(function(filterBtn){
      var selected = filterBtn === btn;
      filterBtn.classList.toggle('on', selected);
      filterBtn.setAttribute('aria-pressed', selected ? 'true' : 'false');
    });
    applyPhotographyFilters();
  };

  function ensureFilmStockCaptions(){
    document.querySelectorAll('#photo-grid .photo-cell[data-medium="film"][data-film]').forEach(function(cell){
      var stock = cell.dataset.film.trim();
      [{ selector: '.photo-caption.en', separator: ', ' }, { selector: '.photo-caption.zh', separator: '，' }].forEach(function(item){
        var caption = cell.querySelector(item.selector);
        if(caption && !caption.textContent.includes(stock)) caption.textContent = caption.textContent.trimEnd() + item.separator + stock;
      });
    });
  }

  function makeFilmStockFilters(){
    var container = document.getElementById('film-stock-options');
    var presetFilmStocks = ['Kodak Gold 400', 'Kodak UltraMax 400', 'Fujifilm Provia'];
    var discoveredFilmStocks = Array.from(document.querySelectorAll('#photo-grid .photo-cell[data-medium="film"][data-film]'))
      .map(function(cell){ return cell.dataset.film.trim(); })
      .filter(Boolean);
    var names = presetFilmStocks.concat(discoveredFilmStocks)
      .filter(function(name, index, all){ return all.indexOf(name) === index; });
    var allButton = document.createElement('button');
    allButton.className = 'photo-topic-btn on';
    allButton.dataset.filterGroup = 'film';
    allButton.dataset.filterValue = 'all';
    allButton.setAttribute('aria-pressed', 'true');
    allButton.innerHTML = '<span class="en">All film</span><span class="zh" style="display:none">全部胶卷</span>';
    allButton.onclick = function(){ window.setPhotographyFilter(allButton); };
    container.appendChild(allButton);

    names.forEach(function(name){
      var button = document.createElement('button');
      button.className = 'photo-topic-btn';
      button.dataset.filterGroup = 'film';
      button.dataset.filterValue = name;
      button.textContent = name;
      button.setAttribute('aria-pressed', 'false');
      button.onclick = function(){ window.setPhotographyFilter(button); };
      container.appendChild(button);
    });
  }

  ensureFilmStockCaptions();
  makeFilmStockFilters();
  applyPhotographyFilters();

})();
</script>

</BaseLayout>
