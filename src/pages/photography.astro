  border-radius:50%;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:background .2s;
  z-index:601;
}
#lightbox-close:hover{background:rgba(255,255,255,.25);}
 
/* Prev / Next buttons */
#lightbox-prev,
#lightbox-next{
  position:fixed;
  top:50%;
  transform:translateY(-50%);
  background:rgba(255,255,255,.1);
  border:none;
  color:#fff;
  font-size:2rem;
  width:44px;
  height:64px;
  border-radius:4px;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:background .2s;
  z-index:601;
}
#lightbox-prev{left:1rem;}
#lightbox-next{right:1rem;}
#lightbox-prev:hover,
#lightbox-next:hover{background:rgba(255,255,255,.22);}
 
/* Hover effect on photo cells */
.photo-cell{
  cursor:pointer;
  transition:transform .2s, box-shadow .2s;
}
.photo-cell:hover{
  transform:translateY(-3px);
  box-shadow:0 8px 28px rgba(0,0,0,.12);
}
.photo-cell img{
  transition:opacity .2s;
}
.photo-cell:hover img{
  opacity:.92;
}
 
@media(max-width:768px){
  #lightbox-prev{left:.3rem;}
  #lightbox-next{right:.3rem;}
  #lightbox-img{max-width:96vw;max-height:78vh;}
}
</style>
 
<script is:inline>
(function(){
  // Collect all visible photo cells with real images
  var _cells = [];
  var _current = 0;
 
  function getCaption(cell){
    var isZh = document.documentElement.lang === 'zh-CN';
    var caps = cell.querySelectorAll('.photo-caption');
    for(var i=0;i<caps.length;i++){
      var el = caps[i];
      if(isZh && el.classList.contains('zh')) return el.textContent;
      if(!isZh && el.classList.contains('en')) return el.textContent;
    }
    return '';
  }
 
  function showLightbox(index){
    var cell = _cells[index];
    if(!cell) return;
    var img = cell.querySelector('img');
    var lb = document.getElementById('lightbox');
    var lbImg = document.getElementById('lightbox-img');
    var lbCap = document.getElementById('lightbox-caption');
 
    if(img){
      lbImg.src = img.src;
      lbImg.alt = img.alt || '';
      lbImg.style.display = 'block';
    } else {
      lbImg.src = '';
      lbImg.style.display = 'none';
    }
    lbCap.textContent = getCaption(cell);
    _current = index;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
 
  window.openLightbox = function(cell){
    // Only open if cell has a real image
    if(!cell.querySelector('img')) return;
    // Build list of currently visible cells that have images
    _cells = Array.from(document.querySelectorAll('.photo-cell'))
      .filter(function(c){ return !c.hidden && c.querySelector('img'); });
    var idx = _cells.indexOf(cell);
    if(idx === -1) idx = 0;
    showLightbox(idx);
  };
 
  window.closeLightbox = function(){
    document.getElementById('lightbox').classList.remove('open');
    document.body.style.overflow = '';
  };
 
  window.lightboxNav = function(e, dir){
    e.stopPropagation();
    var next = (_current + dir + _cells.length) % _cells.length;
    showLightbox(next);
  };
 
  // Keyboard navigation
  document.addEventListener('keydown', function(e){
    var lb = document.getElementById('lightbox');
    if(!lb.classList.contains('open')) return;
    if(e.key === 'Escape') closeLightbox();
    if(e.key === 'ArrowRight') lightboxNav(e, 1);
    if(e.key === 'ArrowLeft')  lightboxNav(e, -1);
  });

  // ── Composable medium / subject / film-stock filters ──
  var photoFilters = { medium: 'all', topic: 'all', film: 'all' };

  function applyPhotographyFilters(){
    var visibleCount = 0;
    document.querySelectorAll('#photo-grid .photo-cell').forEach(function(cell){
      // Existing photos are digital unless explicitly marked as film.
      var medium = cell.dataset.medium || 'digital';
      var film = cell.dataset.film || '';
      var matchesMedium = photoFilters.medium === 'all' || medium === photoFilters.medium;
      var matchesTopic = photoFilters.topic === 'all' || cell.dataset.topic === photoFilters.topic;
      var matchesFilm = photoFilters.medium !== 'film' || photoFilters.film === 'all' || film === photoFilters.film;
      var isVisible = matchesMedium && matchesTopic && matchesFilm;
      cell.hidden = !isVisible;
      if(isVisible) visibleCount++;
    });

    document.getElementById('photo-empty').hidden = visibleCount !== 0;
    document.getElementById('film-stock-filter').hidden = photoFilters.medium !== 'film';
  }

  window.setPhotographyFilter = function(btn){
    var group = btn.dataset.filterGroup;
    var value = btn.dataset.filterValue;
    photoFilters[group] = value;

    document.querySelectorAll('[data-filter-group="' + group + '"]').forEach(function(filterBtn){
      var selected = filterBtn === btn;
      filterBtn.classList.toggle('on', selected);
      filterBtn.setAttribute('aria-pressed', selected ? 'true' : 'false');
    });
    applyPhotographyFilters();
  };

  function makeFilmStockFilters(){
    var container = document.getElementById('film-stock-options');
    var names = Array.from(document.querySelectorAll('#photo-grid .photo-cell[data-medium="film"][data-film]'))
      .map(function(cell){ return cell.dataset.film.trim(); })
      .filter(Boolean)
      .filter(function(name, index, all){ return all.indexOf(name) === index; });
    var allButton = document.createElement('button');
    allButton.className = 'photo-topic-btn on';
    allButton.dataset.filterGroup = 'film';
    allButton.dataset.filterValue = 'all';
    allButton.setAttribute('aria-pressed', 'true');
    allButton.innerHTML = '<span class="en">All film</span><span class="zh" style="display:none">全部胶卷</span>';
    allButton.onclick = function(){ window.setPhotographyFilter(allButton); };
    container.appendChild(allButton);

    names.forEach(function(name){
      var button = document.createElement('button');
      button.className = 'photo-topic-btn';
      button.dataset.filterGroup = 'film';
      button.dataset.filterValue = name;
      button.textContent = name;
      button.setAttribute('aria-pressed', 'false');
      button.onclick = function(){ window.setPhotographyFilter(button); };
      container.appendChild(button);
    });
  }

  makeFilmStockFilters();
  applyPhotographyFilters();

})();
</script>

</BaseLayout>
